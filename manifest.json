{
  "manifest_version": 3,
  "name": "GitHub Easy Stack",
  "version": "0.2.0",
  "description": "Groups stacked pull requests in GitHub pull request lists, with fold and progress per stack.",
  "permissions": ["storage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "github-easy-stack@dejorrit.github.io",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "GitHub Easy Stack",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/core.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
